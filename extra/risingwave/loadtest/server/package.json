{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--max-old-space-size=8192 tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --max-old-space-size=8192 dist/index.js",
    "bench": "tsx src/bench/produce.ts",
    "test": "tsx --test \"src/__tests__/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^8.0.4",
    "fastify": "^5.2.1",
    "kafkajs": "^2.2.4",
    "pg": "^8.13.1",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
